generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. PRIVATE CONTACT MESSAGES
// ==========================================
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}
// ==========================================
// 3. AI CHATBOT HISTORY
// ==========================================
model AiConversation {
  id        String      @id @default(uuid())
  sessionId String      // Groups messages by unique visitor
  createdAt DateTime    @default(now())
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // Will be "user" or "model"
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
// ==========================================
// 3. VISITOR ANALYTICS
// ==========================================
model PageVisit {
  id        String   @id @default(uuid())
  sessionId String   
  page      String   
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([page])
}